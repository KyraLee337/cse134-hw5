---
import '../styles/style.css';
import Footer from '../components/Footer.astro';
---

<html lang="en">
    <head>
        <meta charset="UTF-8">
         <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Kyra Lee's Website</title>
        <link rel="icon" href="#" type="image/x-icon">
        <script>
			import '../scripts/theme.js';
			import '../scripts/jokes.js';
		</script>
    </head>


    <body>
        <header>
            <h1>Kyra Lee's Website</h1>
            <button type="button" id="toggle-theme" hidden>Switch to dark mode</button>
            <nav>
                <ul class="navbar">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Me</a></li>
                    <li><a href="work.html">Work</a></li>
                    <li><a href="contact.html">Contact</a></li>
                    <li><a href="form-no-js.html">Contact no JS</a></li>
                    <li><a href="form-with-js.html">Contact with JS</a></li>
                </ul>
            </nav>
        </header>
        <main>
            <h2>About Me</h2>
            <section>
                <h3>Bio</h3>
                <p>My name is Kyra Lee and I am a third year undergraduate student at UCSD majoring in Computer Science. I am interested in CS education research as well as low level systems.</p>
                <label for="grad">Time left of undergrad: </label>
                <progress id="grad" max="100" value="75">75%</progress>
                <p>I enjoy seeking out teaching opportunities outside of my academics.</p>
            </section>
            <section>
                <h3>Skills/Background</h3>
                <p>Skills: Mentoring, communication, and teaching</p>
                <p>Technical: C, C++, Python, Java, HTML/CSS, TypeScript</p>
                <p>Software and Tools: Git, GDB, Valgrind, Makefiles, Google Workspace</p>
                <div>
                    <b>Work Experience</b>
                    <ol>
                        <li>Instructional Assistant</li>
                        <li>Programs Coordinator</li>
                        <li>Section Leader for Code In Place</li>
                    </ol>
                </div>
            </section>
        </main>
        <button type="button" id="toggle-details" hidden>Hide Dad Jokes</button>
        <dad-jokes>
            <noscript>
                <p>Please Enable JavaScript to see jokes.</p>
            </noscript>
        </dad-jokes>
        <Footer />
    </body>
</html>